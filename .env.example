# ============================================
# SQL Server
# ============================================
# Senha do usuário 'sa' (mínimo 8 chars, maiúscula, minúscula, número e símbolo)
MSSQL_SA_PASSWORD=sua-senha-sql-server

# ============================================
# JWT
# ============================================
JWT_ISSUER=RentalFlow
JWT_AUDIENCE=RentalFlow

# Chave secreta (mínimo 32 caracteres)
# Gere com: [Convert]::ToBase64String((1..64 | % { Get-Random -Maximum 256 }))
JWT_SECRET_KEY=sua-chave-jwt

# Tempo de expiração (em minutos)
JWT_ACCESS_EXPIRATION=60

# Tempo de expiração (em dias)
JWT_REFRESH_EXPIRATION=7

# ============================================
# Seed
# ============================================
# Dados do primeiro administrador
SEED_ADMIN_EMAIL=seu-email-para-primeiro-admin
SEED_ADMIN_PASSWORD=sua-senha-para-primeiro-admin
SEED_ADMIN_NAME=seu-username-para-primeiro-admin
SEED_TEAM_NAME=seu-primeiro-time-para-o-admin